local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local userInputService = game:GetService("UserInputService")

local isShiftPressed = false

-- Função para lidar com a entrada do teclado
local function onInputBegan(input, gameProcessedEvent)
    if not gameProcessedEvent then
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.LeftShift then
            isShiftPressed = true
            humanoid.WalkSpeed = 30 -- Aumenta a velocidade ao pressionar Shift
        end
    end
end

local function onInputEnded(input, gameProcessedEvent)
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.LeftShift then
        isShiftPressed = false
        humanoid.WalkSpeed = 16 -- Velocidade padrão
    end
end

-- Conectar as funções aos eventos de entrada
userInputService.InputBegan:Connect(onInputBegan)
userInputService.InputEnded:Connect(onInputEnded)
